{
  "name": "crow-acp",
  "displayName": "Crow ACP Chat",
  "description": "Crow assistant-ui chat connected directly to a local ACP WebSocket agent.",
  "version": "0.1.0",
  "publisher": "crow-ai",
  "license": "MIT",
  "engines": {
    "vscode": "^1.100.0"
  },
  "categories": [
    "AI",
    "Other"
  ],
  "main": "./dist/extension.cjs",
  "extensionKind": [
    "workspace"
  ],
  "activationEvents": [
    "onCommand:crowAcp.open",
    "onCommand:crowAcp.openSidebar",
    "onView:crowAcp.sidebar"
  ],
  "contributes": {
    "commands": [
      {
        "command": "crowAcp.open",
        "title": "Crow ACP: Open Chat"
      },
      {
        "command": "crowAcp.openSidebar",
        "title": "Crow ACP: Open Sidebar"
      },
      {
        "command": "crowAcp.moveToEditor",
        "title": "Move to Editor",
        "icon": "$(arrow-right)"
      },
      {
        "command": "crowAcp.session.new",
        "title": "New Session",
        "icon": "$(add)"
      },
      {
        "command": "crowAcp.session.switch",
        "title": "Switch Session",
        "icon": "$(history)"
      },
      {
        "command": "crowAcp.collapseAll",
        "title": "Toggle All Tool Calls and Thoughts",
        "icon": "$(collapse-all)"
      },
      {
        "command": "crowAcp.settings",
        "title": "Crow ACP Settings",
        "icon": "$(settings-gear)"
      },
      {
        "command": "crowAcp.editor.session.new",
        "title": "New Session",
        "icon": "$(add)"
      },
      {
        "command": "crowAcp.editor.session.switch",
        "title": "Switch Session",
        "icon": "$(history)"
      },
      {
        "command": "crowAcp.editor.collapseAll",
        "title": "Toggle All Tool Calls and Thoughts",
        "icon": "$(collapse-all)"
      },
      {
        "command": "crowAcp.editor.settings",
        "title": "Crow ACP Settings",
        "icon": "$(settings-gear)"
      }
    ],
    "menus": {
      "commandPalette": [
        { "command": "crowAcp.editor.session.new", "when": "false" },
        { "command": "crowAcp.editor.session.switch", "when": "false" },
        { "command": "crowAcp.editor.collapseAll", "when": "false" },
        { "command": "crowAcp.editor.settings", "when": "false" }
      ],
      "editor/title": [
        {
          "command": "crowAcp.editor.session.new",
          "when": "activeWebviewPanelId == 'crowAcp.chat'",
          "group": "navigation@1"
        },
        {
          "command": "crowAcp.editor.session.switch",
          "when": "activeWebviewPanelId == 'crowAcp.chat'",
          "group": "navigation@2"
        },
        {
          "command": "crowAcp.editor.collapseAll",
          "when": "activeWebviewPanelId == 'crowAcp.chat'",
          "group": "navigation@3"
        },
        {
          "command": "crowAcp.editor.settings",
          "when": "activeWebviewPanelId == 'crowAcp.chat'",
          "group": "navigation@4"
        }
      ],
      "view/title": [
        {
          "command": "crowAcp.session.new",
          "when": "view == crowAcp.sidebar",
          "group": "navigation@1"
        },
        {
          "command": "crowAcp.session.switch",
          "when": "view == crowAcp.sidebar",
          "group": "navigation@2"
        },
        {
          "command": "crowAcp.moveToEditor",
          "when": "view == crowAcp.sidebar",
          "group": "navigation@3"
        },
        {
          "command": "crowAcp.settings",
          "when": "view == crowAcp.sidebar",
          "group": "navigation@4"
        }
      ]
    },
    "viewsContainers": {
      "activitybar": [
        { "id": "crowAcp", "title": "Crow", "icon": "media/crow.svg" }
      ]
    },
    "views": {
      "crowAcp": [
        {
          "id": "crowAcp.sidebar",
          "name": "Crow",
          "type": "webview"
        }
      ]
    },
    "configuration": {
      "title": "Crow ACP",
      "properties": {
        "crowAcp.backend": {
          "type": "string",
          "enum": ["spawn", "external"],
          "default": "spawn",
          "description": "spawn: the extension starts a crow-cli acp2 daemon for this window and stops it when the window closes. external: proxy crowAcp.endpoint instead. Applies on window reload."
        },
        "crowAcp.cliCommand": {
          "type": "array",
          "items": { "type": "string" },
          "default": ["crow-cli"],
          "description": "argv that runs crow-cli for the spawned daemon, e.g. [\"uv\", \"--project\", \"/path/to/crow-cli\", \"run\", \"crow-cli\"] to run from a source checkout. Applies on window reload."
        },
        "crowAcp.model": {
          "type": "string",
          "default": "",
          "description": "Model for the spawned daemon (passed as --model). Empty uses crow-cli's configured default. Applies on window reload."
        },
        "crowAcp.port": {
          "type": "number",
          "default": 2771,
          "description": "First port tried when spawning the daemon; cycles upward until one is free. Applies on window reload."
        },
        "crowAcp.endpoint": {
          "type": "string",
          "default": "ws://127.0.0.1:2771/acp",
          "description": "ACP WebSocket endpoint of an existing daemon, used when crowAcp.backend is external. The chat webview connects through the extension's local proxy either way."
        },
        "crowAcp.cwd": {
          "type": "string",
          "default": "",
          "description": "Agent working directory. Empty uses the active workspace folder (a Linux path when the extension runs in WSL)."
        },
        "crowAcp.protocol": {
          "type": "string",
          "enum": [
            "auto",
            "1",
            "2"
          ],
          "default": "2",
          "description": "ACP protocol version. Auto uses the existing Crow client endpoint detection."
        },
        "crowAcp.mcpConfig": {
          "type": "string",
          "default": "mcpServers:\n  crow-mcp:\n    transport: stdio\n    command: crow-cli\n    args: [mcp2]\n",
          "description": "MCP server configuration (YAML or JSON) supplied to the agent. Stdio commands run on the agent machine."
        }
      }
    }
  },
  "scripts": {
    "build": "bun build src/extension.ts --target=node --format=cjs --external=vscode --outfile=dist/extension.cjs && bun ../chat/node_modules/vite/bin/vite.js build --config vite.config.ts",
    "typecheck": "tsc --noEmit && bun run --cwd ../chat typecheck",
    "test": "bun test test/unit",
    "test:integration": "bun test test/integration --timeout 120000",
    "test:e2e": "bun e2e/run-all.ts",
    "package": "bun run build && vsce package --no-dependencies --allow-missing-repository --out crow-acp-0.1.0.vsix"
  },
  "type": "module",
  "dependencies": {
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/ws": "^8.5.0",
    "vite": "^8.3.2",
    "@vitejs/plugin-react": "^6.1.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/vscode": "^1.100.0",
    "@vscode/vsce": "^3.7.0",
    "typescript": "^5.9.3"
  }
}
