{
  "name": "@crow/web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "The browser host for @crow/chat: a standalone page that is itself an ACP client.",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "dev": "bun ./node_modules/vite/bin/vite.js --config vite.config.ts",
    "build": "bun ./node_modules/vite/bin/vite.js build --config vite.config.ts",
    "stub": "bun dev/stub-agent.ts",
    "serve": "bun dev/serve-dist.ts",
    "e2e": "bun test e2e"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.3",
    "@vitejs/plugin-react": "^6.1.1",
    "bun-types": "^1.4.2",
    "playwright": "^1.64.1",
    "typescript": "^5.9.3",
    "vite": "^8.3.2"
  }
}
